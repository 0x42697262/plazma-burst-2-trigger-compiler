{
  "name": "pb2-trigger-compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles source code into Plazma Burst 2 map triggers (XML and editor text)",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "snapshot-opcodes": "node src/tools/snapshot-opcodes/cli.ts",
    "compile": "node src/cli/cli.ts",
    "emit-sample": "node src/tools/emit-sample/cli.ts",
    "live-check": "node src/tools/live-check/cli.ts",
    "actions-doc": "node src/tools/actions-doc/cli.ts",
    "check": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 src",
    "test": "node --test 'src/**/*.test.ts'",
    "verify": "npm run lint && npm run check && npm test",
    "lsp": "node src/lsp/server.ts --stdio",
    "web": "node src/tools/build-web/cli.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "10.0.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "26.6.6",
    "codemirror": "^6.0.2",
    "dockview-core": "^8.8.3",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "bin": {
    "ptc-lsp": "bin/ptc-lsp.js"
  }
}
