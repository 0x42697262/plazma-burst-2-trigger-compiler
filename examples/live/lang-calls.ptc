// Functions, recursion, argument order and short-circuit logic.
var factorial10 = 0;
var fib12 = 0;
var swapped = "";
var calls = 0;
function factorial(n) { if (n <= 1) { return 1; } return n * factorial(n - 1); }
function fib(n) { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
function pair(x, y) { return x .. y; }
function swap(x, y) { return pair(y, x); }
function touch() { calls += 1; return 1; }
on start {
  factorial10 = factorial(10);
  fib12 = fib(12);
  swapped = swap(1, 2);
  if (false && touch()) { }
  if (true || touch()) { }
  if (true && touch()) { }
}
