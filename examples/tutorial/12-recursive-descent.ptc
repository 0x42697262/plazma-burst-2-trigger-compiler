// Infix again, with a recursive-descent parser: one function per grammar rule.
//   expression = term { ("+" | "-") term }
//   term       = factor { ("*" | "/") factor }
//   factor     = number | "(" expression ")" | "-" factor
import "lib/tokenizer.ptc";

var position = 0;

function peek() {
  if (position < len(tokens)) { return tokens[position]; }
  return "";
}

function factor() {
  let t = peek();
  position += 1;
  if (t == "-") { return -factor(); }
  if (t == "(") {
    let inside = expression();
    position += 1;
    return inside;
  }
  return number(t);
}

function term() {
  let value = factor();
  while (peek() == "*" || peek() == "/") {
    let op = peek();
    position += 1;
    value = apply(op, value, factor());
  }
  return value;
}

function expression() {
  let value = term();
  while (peek() == "+" || peek() == "-") {
    let op = peek();
    position += 1;
    value = apply(op, value, term());
  }
  return value;
}

function calculate(text) {
  tokenize(text);
  position = 0;
  return expression();
}

on start {
  say("2 * (3 + 4) - -5 = {calculate("2 * (3 + 4) - -5")}");
  say("10 / 4 - 1 = {calculate("10 / 4 - 1")}");
  say("-(2 + 3) * 4 = {calculate("-(2 + 3) * 4")}");
}
