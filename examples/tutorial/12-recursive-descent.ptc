// Infix again, with a recursive-descent parser: one function per grammar rule.
//   expression = term { ("+" | "-") term }
//   term       = factor { ("*" | "/") factor }
//   factor     = number | "(" expression ")" | "-" factor
var tokens[];

function isDigit(c) { return contains("0123456789.", c); }

function tokenize(text) {
  clear(tokens);
  let i = 0;
  while (i < len(text)) {
    let c = charAt(text, i);
    if (c == " ") {
      i += 1;
    } else if (isDigit(c)) {
      let digits = "";
      while (i < len(text) && isDigit(charAt(text, i))) { digits ..= charAt(text, i); i += 1; }
      push(tokens, digits);
    } else {
      push(tokens, c);
      i += 1;
    }
  }
  return len(tokens);
}

function pow(base, exponent) {
  let result = 1;
  for (let i = 0; i < exponent; i += 1) { result *= base; }
  return result;
}

function apply(operator, a, b) {
  if (operator == "+") { return a + b; }
  if (operator == "-") { return a - b; }
  if (operator == "*") { return a * b; }
  if (operator == "/") { return a / b; }
  return pow(a, b);
}

var position = 0;

function peek() {
  if (position < len(tokens)) { return tokens[position]; }
  return "";
}

function factor() {
  let t = peek();
  position += 1;
  if (t == "-") { return -factor(); }
  if (t == "(") {
    let inside = expression();
    position += 1;
    return inside;
  }
  return number(t);
}

function term() {
  let value = factor();
  while (peek() == "*" || peek() == "/") {
    let op = peek();
    position += 1;
    value = apply(op, value, factor());
  }
  return value;
}

function expression() {
  let value = term();
  while (peek() == "+" || peek() == "-") {
    let op = peek();
    position += 1;
    value = apply(op, value, term());
  }
  return value;
}

function calculate(text) {
  tokenize(text);
  position = 0;
  return expression();
}

on start {
  say("2 * (3 + 4) - -5 = {calculate("2 * (3 + 4) - -5")}");
  say("10 / 4 - 1 = {calculate("10 / 4 - 1")}");
  say("-(2 + 3) * 4 = {calculate("-(2 + 3) * 4")}");
}
