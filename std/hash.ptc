// Standard library: hash(text) turns text into "a-b-c", three numbers that cannot be turned back
// into the text. Use it to check a password without writing the password into the map:
//
//   import "std/hash.ptc";
//   secret const PASSWORD = env("MAP_PASSWORD");
//   const PASSWORD_HASH = hash(PASSWORD);
//   on chat { if (hash(chatText()) == PASSWORD_HASH) { say("welcome"); } }
//
// hashContinue(hash(a), b) equals hash(a + b): the map can finish a hash whose start is a secret
// without knowing the secret (see tutorial 26).
//
// Letters, digits, spaces and the signs !#$%'()*+,-./:;=?@[\]^_`{|}~ count as themselves.
// & < > " and characters outside this list all count as one same character, so leave them out
// of passwords. Each character costs about 30 actions.

const HASH_ALPHABET = " !#$%'()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~";
var hashCodes[];
var hashReady = 0;
var hashFirst = 0;
var hashSecond = 0;
var hashThird = 0;

function hashSetup() {
  if (hashReady == 1) { return; }
  for (let i = 0; i < len(HASH_ALPHABET); i += 1) { hashCodes[charAt(HASH_ALPHABET, i)] = i + 1; }
  hashReady = 1;
}

function hashFeed(text) {
  hashSetup();
  for (let i = 0; i < len(text); i += 1) {
    let character = charAt(text, i);
    let code = 0;
    if (contains(HASH_ALPHABET, character)) { code = hashCodes[character]; }
    hashFirst = (hashFirst * 31 + code) % 67108859;
    hashSecond = (hashSecond * 37 + code) % 67108837;
    hashThird = (hashThird * 41 + code) % 67108819;
  }
  return "{hashFirst}-{hashSecond}-{hashThird}";
}

function hash(text) {
  hashFirst = 7;
  hashSecond = 11;
  hashThird = 13;
  return hashFeed(text);
}

function hashContinue(state, text) {
  hashFirst = 0;
  hashSecond = 0;
  hashThird = 0;
  let part = 0;
  for (let i = 0; i < len(state); i += 1) {
    let character = charAt(state, i);
    if (character == "-") {
      part += 1;
    } else if (part == 0) {
      hashFirst = hashFirst * 10 + number(character);
    } else if (part == 1) {
      hashSecond = hashSecond * 10 + number(character);
    } else {
      hashThird = hashThird * 10 + number(character);
    }
  }
  return hashFeed(text);
}
