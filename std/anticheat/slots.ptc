    action(123, who, 12); action(MakeCharDropGuns, "12", 0);
    action(123, who, 13); action(MakeCharDropGuns, "13", 0);
    action(123, who, 14); action(MakeCharDropGuns, "14", 0);
    action(123, who, 15); action(MakeCharDropGuns, "15", 0);
  } else {
    action(123, who, 16); action(MakeCharDropGuns, "16", 0);
    action(123, who, 17); action(MakeCharDropGuns, "17", 0);
    action(123, who, 18); action(MakeCharDropGuns, "18", 0);
    action(123, who, 19); action(MakeCharDropGuns, "19", 0);
    action(123, who, 20); action(MakeCharDropGuns, "20", 0);
    action(123, who, 21); action(MakeCharDropGuns, "21", 0);
    action(123, who, 22); action(MakeCharDropGuns, "22", 0);
    action(123, who, 23); action(MakeCharDropGuns, "23", 0);
    action(123, who, 24); action(MakeCharDropGuns, "24", 0);
    action(123, who, 25); action(MakeCharDropGuns, "25", 0);
