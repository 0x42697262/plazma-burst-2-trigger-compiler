    action(123, who, 28); action(MakeCharDropGuns, "28", 0);
    action(123, who, 29); action(MakeCharDropGuns, "29", 0);
    action(123, who, 30); action(MakeCharDropGuns, "30", 0);
    action(123, who, 31); action(MakeCharDropGuns, "31", 0);
  }
}
