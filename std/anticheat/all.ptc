// Standard library: every anti-cheat check at once. To pick some, import those files instead:
//
//   std/anticheat/movement.ptc   run speed, jump speed, rising against gravity
//   std/anticheat/teleport.ptc   moves longer than the speed allows
//   std/anticheat/health.ptc     hitpoints above max, sudden heals, revives in place, refused damage
//   std/anticheat/zoom.ptc       camera zoomed out past the map's zoom
//   std/anticheat/guns.ptc       held guns the map does not give (needs acAllowGun)
//   std/anticheat/zones.ptc      players inside solid or closed places (needs acForbidBox)
//   std/anticheat/triggers.ptc   bait triggers, bait variables, region use from afar (acGuardUse)
//   std/anticheat/calibrate.ptc  while testing only: prints the values to set the limits from
//
// Guide, settings and what is not supported: std/anticheat/anticheat.md.

import "std/anticheat/movement.ptc";
import "std/anticheat/teleport.ptc";
import "std/anticheat/health.ptc";
import "std/anticheat/zoom.ptc";
import "std/anticheat/guns.ptc";
import "std/anticheat/zones.ptc";
import "std/anticheat/triggers.ptc";
